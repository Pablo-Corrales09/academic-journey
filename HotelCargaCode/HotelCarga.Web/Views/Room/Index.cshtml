@model HotelCarga.Models.Rooms.RoomIndexViewModel

@{
    ViewData["Title"] = "Habitaciones";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
}

<div class="room-shell" data-page="index">
    <section class="room-hero py-4" data-animate style="background-image: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('https://images.unsplash.com/photo-1590490359683-658d3d23f972?auto=format&fit=crop&w=1200&q=80'); background-size: cover; background-position: center;">
        <div class="room-hero__content">
            <h1>Administre sus habitaciones con un enfoque profesional.</h1>
            <p>Supervise la disponibilidad, ajuste estrategias de precios y gestione las unidades operativas de su hotel.</p>
            
            <div class="room-hero__actions d-flex justify-content-between align-items-center mt-4" style="width: 100%; max-width: 550px;">
                <a asp-action="Create" class="room-button shadow-sm" style="background-color: #28a745; border-color: #28a745; color: white;">
                    <i class="fas fa-plus mr-2"></i>Nueva Habitación
                </a>
                <a asp-action="GetAll" class="room-button room-button--ghost" style="color: #ffc107; border-color: #ffc107;">
                    <i class="fas fa-sync-alt mr-2"></i>Restablecer Filtros
                </a>
            </div>
        </div>

        <div class="room-hero__panel">
            <div class="room-stat-grid text-center">
                <article class="room-stat-card">
                    <span>Inventario Total</span>
                    <strong data-count="@Model.Stats.TotalRooms">@Model.Stats.TotalRooms</strong>
                </article>
                <article class="room-stat-card">
                    <span>Resultados</span>
                    <strong data-count="@Model.Stats.MatchingRooms">@Model.Stats.MatchingRooms</strong>
                </article>
                <article class="room-stat-card">
                    <span>Disponibles Hoy</span>
                    <strong data-count="@Model.Stats.AvailableRooms">@Model.Stats.AvailableRooms</strong>
                </article>
                <article class="room-stat-card">
                    <span>Tarifa Promedio</span>
                    <strong>@Model.Stats.AverageNightlyRate.ToString("C")</strong>
                </article>
            </div>
        </div>
    </section>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="room-alert room-alert--success mx-3 mt-3" data-animate>@successMessage</div>
    }

    <section class="room-surface mt-n4 mb-4 shadow-sm p-3" data-animate style="position: relative; z-index: 10; border-radius: 12px;">
        <div class="room-surface__header mb-2 border-bottom pb-2">
            <h2 class="h6 font-weight-bold text-uppercase text-muted">Búsqueda Avanzada</h2>
        </div>

        <form asp-action="Index" method="get" class="form-row align-items-end mx-0">
            <div class="col-md-2 mb-2 px-1">
                <label class="small font-weight-bold">Número</label>
                <input asp-for="Filters.RoomNumber" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 mb-2 px-1">
                <label class="small font-weight-bold">Mínimo</label>
                <input asp-for="Filters.MinRate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 mb-2 px-1">
                <label class="small font-weight-bold">Máximo</label>
                <input asp-for="Filters.MaxRate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3 mb-2 px-1">
                <label class="small font-weight-bold">Estado</label>
                <select asp-for="Filters.StatusId" asp-items="Model.StatusOptions" class="form-control form-control-sm">
                    <option value="">Cualquier estado</option>
                </select>
            </div>
            <div class="col-md-3 mb-2 px-1">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1 font-weight-bold">Filtrar</button>
                    <a asp-action="GetAll" class="btn btn-outline-secondary btn-sm px-3 ml-2">Limpiar</a>
                </div>
            </div>
        </form>
    </section>

    <section class="room-surface mb-5 p-3" data-animate>
        <div class="room-surface__header mb-4 border-bottom pb-2 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="h5 mb-0">Listado de Unidades Operativas</h2>
                <p class="small text-muted mb-0">@Model.Rooms.Count habitaciones registradas.</p>
            </div>
        </div>

        @if (Model.Rooms.Count == 0)
        {
            <div class="text-center py-5">
                <i class="fas fa-door-closed h1 text-muted opacity-50"></i>
                <p class="mt-2 text-muted">No hay resultados para esta búsqueda.</p>
            </div>
        }
        else
        {
            <div class="row mx-0">
                @foreach (var room in Model.Rooms)
                {
                    var categoria = room.CategoryName?.ToUpper() ?? "";
                    string urlImagen = categoria switch
                    {
                        var c when c.Contains("SENCILLA") => "https://images.unsplash.com/photo-1505691938895-1758d7eaa511?q=80&w=600&auto=format&fit=crop",
                        var c when c.Contains("DELUXE")   => "https://images.unsplash.com/photo-1566665797739-1674de7a421a?q=80&w=600&auto=format&fit=crop",
                        var c when c.Contains("PREMIUM")  => "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?q=80&w=600&auto=format&fit=crop",
                        var c when c.Contains("SUITE")    => "https://images.unsplash.com/photo-1591088398332-8a7791972843?q=80&w=600&auto=format&fit=crop",
                        _                                 => "https://images.unsplash.com/photo-1590490359683-658d3d23f972?q=80&w=600&auto=format&fit=crop" 
                    };

                    <div class="col-12 col-md-6 col-lg-4 mb-4 px-2">
                        <article class="card h-100 shadow-sm border-0" style="border-radius: 12px; overflow: hidden; background: #fff;">
                            <div style="height: 180px; width: 100%; position: relative; background: #eee;">
                                <img src="@urlImagen" 
                                     alt="Habitación" 
                                     style="width: 100%; height: 100%; object-fit: cover;"
                                     onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=600&auto=format&fit=crop';" />
                                
                                <div style="position: absolute; top: 10px; right: 10px;">
                                    @{
                                        var status = room.StatusName?.ToUpper();
                                        var badgeColor = status == "AVAILABLE" ? "badge-success" : (status == "OCCUPIED" ? "badge-danger" : "badge-warning");
                                    }
                                    <span class="badge @badgeColor px-3 py-2 shadow-sm">@room.StatusName</span>
                                </div>
                            </div>

                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h3 class="h6 font-weight-bold mb-0 text-dark">@room.CategoryName</h3>
                                    <span class="badge badge-light border text-muted px-2">#@room.RoomNumber</span>
                                </div>

                                <p class="small text-muted flex-grow-1" style="line-height: 1.3;">
                                    Ubicada en el <strong>Piso @(room.FloorNumber ?? 1)</strong>. Espacio diseñado para la eficiencia y el confort.
                                </p>

                                <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded mb-3">
                                    <small class="text-muted font-weight-bold">Tarifa Diaria:</small>
                                    <strong class="text-primary h6 mb-0">@room.NightlyRate.ToString("C")</strong>
                                </div>

                                <div class="d-flex justify-content-between align-items-center border-top pt-3">
                                    <a asp-action="Details" asp-route-id="@room.Id" class="btn btn-primary btn-sm px-4">Ver Detalles</a>
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@room.Id" class="btn btn-outline-secondary btn-sm border-0"><i class="fas fa-edit"></i></a>
                                        <a asp-action="Delete" asp-route-id="@room.Id" class="btn btn-outline-danger btn-sm border-0 ml-1"><i class="fas fa-trash"></i></a>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/room/index.js" asp-append-version="true"></script>
}