@model HotelCarga.Models.Users.UserIndexViewModel

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
}

<div class="user-shell" data-page="index">
    <section class="user-hero" data-animate style="background-image: linear-gradient(to right, rgba(0,0,0,0.8), rgba(0,0,0,0.2)), url('https://images.unsplash.com/photo-1556745753-b2904692b3cd?auto=format&fit=crop&w=1200&q=80'); background-size: cover; background-position: center;">
        <div class="user-hero__content">
            <h1>Gestione la identidad de su equipo con un flujo de trabajo eficiente.</h1>
            <p>Supervise cada cuenta de acceso, filtre el directorio de empleados y utilice herramientas de validación rápida para asegurar la integridad de los datos de su hotel.</p>
            <div class="user-hero__actions" style="display: flex; justify-content: flex-end;">
                <a asp-action="Create" class="user-button btn btn-primary">Nuevo Usuario</a>
            </div>
        </div>
        <div class="user-hero__panel">
            <div class="user-stat-grid">
                <article class="user-stat-card">
                    <span>Usuarios registrados</span>
                    <strong data-count="@Model.Stats.TotalUsers">@Model.Stats.TotalUsers</strong>
                </article>
                <article class="user-stat-card">
                    <span>Usuarios activos</span>
                    <strong data-count="@Model.Stats.ActiveUsers">@Model.Stats.ActiveUsers</strong>
                </article>
            </div>
        </div>
    </section>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="user-alert user-alert--success" data-animate>@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="user-alert user-alert--error" data-animate>@errorMessage</div>
    }

    <section class="user-surface" data-animate>
        <div class="user-surface__header">
            <div>
                <h2>Busqueda avanzada</h2>
            </div>
        </div>

        <form asp-action="Index" method="get" class="user-filter-grid">
            <div class="user-field">
                <label>Correo Electrónico</label>
                <input asp-for="Filters.Email" class="user-input" placeholder="usuario@hotelcarga.com" />
            </div>
            <div class="user-field">
                <label>Rol de Acceso</label>
                <select asp-for="Filters.RoleId" asp-items="Model.RoleOptions" class="user-input">
                    <option value="">Todos los roles</option>
                </select>
            </div>
            <div class="user-field">
                <label>Estado de Cuenta</label>
                <select asp-for="Filters.StatusId" asp-items="Model.StatusOptions" class="user-input">
                    <option value="">Todos los estados</option>
                </select>
            </div>
            <div class="user-form-actions user-form-actions--inline">
                <button type="submit" class="user-button">Aplicar Filtros</button>
                <a asp-action="GetAll" class="user-button user-button--ghost">Limpiar</a>
            </div>
        </form>
    </section>



    <section class="user-surface" data-animate>
        <div class="user-surface__header">
            <div>
                <span class="user-section-tag">Directorio Operativo</span>
                <h2>Lista de cuentas registradas</h2>
            </div>
            <p>@Model.Users.Count registros encontrados en el sistema.</p>
        </div>

        @if (Model.Users.Count == 0)
        {
            <div class="user-empty-state">
                <img src="https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&fit=crop&w=300&q=80" class="mb-4 rounded" style="max-width: 200px; opacity: 0.6;" />
                <h3>No se encontraron usuarios con estos criterios.</h3>
                <p>Intente ajustar los filtros o cree una nueva cuenta para ampliar el directorio.</p>
            </div>
        }
        else
        {
            <div class="user-card-grid">
                @foreach (var user in Model.Users)
                {
                    <article class="user-card" data-animate>
                        <div class="user-card__header">
                            <div>
                                <span class="user-chip">@user.RoleName</span>
                                <h3>@user.Username</h3>
                            </div>
                            <span class="user-status-pill">@user.StatusName</span>
                        </div>
                        <dl class="user-card__meta">
                            <div>
                                <dt>Correo</dt>
                                <dd>@user.Email</dd>
                            </div>
                            <div>
                                <dt>Nivel de Acceso</dt>
                                <dd>@user.RoleName</dd>
                            </div>
                            <div>
                                <dt>Estado</dt>
                                <dd>@user.StatusName</dd>
                            </div>
                        </dl>
                        <div class="user-card__actions">
                            <a asp-action="GetById" asp-route-id="@user.Id" class="user-button">Ver Perfil</a>
                            <a asp-action="Update" asp-route-id="@user.Id" class="user-button btn btn-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@user.Id" class="user-button user-button--ghost user-button--danger">Baja</a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/user/index.js" asp-append-version="true"></script>
}