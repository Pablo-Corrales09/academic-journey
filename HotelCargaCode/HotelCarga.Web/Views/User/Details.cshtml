@model HotelCarga.Models.Users.UserDetailsViewModel

@{
    ViewData["Title"] = $"Perfil de {Model.User.Username}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
}

<div class="user-shell" data-page="details">
    <section class="user-hero user-hero--compact" data-animate>
        <div class="user-hero__content d-flex align-items-center">
            <div class="mr-4">
                <img src="https://images.unsplash.com/photo-1633332755192-727a05c4013d?q=80&w=200&h=200&auto=format&fit=crop" 
                     alt="Foto de perfil" 
                     class="rounded-circle shadow-lg border border-white" 
                     style="width: 120px; height: 120px; object-fit: cover;" />
            </div>
            <div>
                <h1 class="mb-1">@Model.User.Username</h1>
                <p class="mb-3">El usuario <strong>@Model.User.Email</strong> tiene asignado el nivel de acceso <strong>@Model.User.RoleName</strong> y su estado actual es <strong>@Model.User.StatusName</strong>.</p>
                <div class="user-hero__actions">
                    <a asp-action="Update" asp-route-id="@Model.User.Id" class="user-button">Actualizar Datos</a>
                    <a asp-action="Index" class="user-button user-button--ghost">Volver al Listado</a>
                </div>
            </div>
        </div>
        
        <div class="user-hero__panel">
            <div class="user-stat-grid">
                <article class="user-stat-card">
                    <span>ID de Sistema</span>
                    <strong>#@Model.User.Id</strong>
                </article>
                <article class="user-stat-card">
                    <span>Cliente Asociado</span>
                    <strong>@(Model.User.CustomerId?.ToString() ?? "Particular")</strong>
                </article>
                <article class="user-stat-card">
                    <span>Disponibilidad</span>
                    <strong>@Model.User.StatusName</strong>
                </article>
            </div>
        </div>
    </section>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="user-alert user-alert--success" data-animate>@successMessage</div>
    }

    <section class="user-surface" data-animate>
    <div class="user-surface__header mb-3">
        <div>
            <h2 class="h5">Detalles de la Cuenta</h2>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between p-3 bg-light rounded shadow-sm border">
        <div class="d-flex align-items-center px-3 border-right">
            <i class="fas fa-user-shield text-primary mr-3"></i>
            <div>
                <small class="text-muted d-block text-uppercase font-weight-bold" style="font-size: 10px;">Rol</small>
                <strong class="text-dark">@Model.User.RoleName</strong>
            </div>
        </div>

        <div class="d-flex align-items-center px-3 border-right">
            <i class="fas fa-check-circle text-success mr-3"></i>
            <div>
                <small class="text-muted d-block text-uppercase font-weight-bold" style="font-size: 10px;">Estado</small>
                <strong class="text-dark">@Model.User.StatusName</strong>
            </div>
        </div>

        <div class="d-flex align-items-center px-3 border-right">
            <i class="fas fa-id-badge text-info mr-3"></i>
            <div>
                <small class="text-muted d-block text-uppercase font-weight-bold" style="font-size: 10px;">ID Cliente</small>
                <strong class="text-dark">@(Model.User.CustomerId?.ToString() ?? "Particular")</strong>
            </div>
        </div>

        <div class="d-flex align-items-center px-3">
            <i class="fas fa-lock text-secondary mr-3"></i>
            <div>
                <small class="text-muted d-block text-uppercase font-weight-bold" style="font-size: 10px;">Seguridad</small>
                <code class="text-dark" style="font-size: 13px;">@Model.CredentialPreview</code>
            </div>
        </div>
    </div>
</section>

    <section class="user-surface" data-animate>
        <div class="user-surface__header">
            <div>
                <span class="user-section-tag">Auditoría</span>
                <h2>Historial de Registro</h2>
            </div>
            <p>Seguimiento del ciclo de vida de la cuenta desde su creación.</p>
        </div>

        <div class="user-detail-grid user-detail-grid--two">
            <article class="user-detail-card">
                <div class="d-flex align-items-center">
                    <i class="fas fa-calendar-plus mr-3 text-primary"></i>
                    <div>
                        <span>Fecha de Alta</span>
                        <strong>@(Model.CreatedAt?.ToString("dd MMM, yyyy - HH:mm") ?? "No registrada")</strong>
                    </div>
                </div>
            </article>
            <article class="user-detail-card">
                <div class="d-flex align-items-center">
                    <i class="fas fa-edit mr-3 text-primary"></i>
                    <div>
                        <span>Última Actualización</span>
                        <strong>@(Model.UpdatedAt?.ToString("dd MMM, yyyy - HH:mm") ?? "Sin cambios recientes")</strong>
                    </div>
                </div>
            </article>
        </div>
    </section>

</div>

@section Scripts {
    <script src="~/js/user/details.js" asp-append-version="true"></script>
}