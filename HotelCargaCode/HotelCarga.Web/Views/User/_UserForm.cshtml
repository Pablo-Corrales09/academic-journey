@model HotelCarga.Models.Users.UserFormViewModel

<section class="user-surface" data-animate>
    <div class="user-surface__header">
        <div>
            <span class="user-section-tag">Account Form</span>
            <h2>@Model.PageTitle</h2>
        </div>
        <p>@Model.IntroText</p>
    </div>

    <form asp-action="@ViewContext.RouteData.Values["action"]" asp-route-id="@Model.Id" method="post" class="user-form-grid">
        <input type="hidden" asp-for="Id" />
        @Html.AntiForgeryToken()
        <input type="hidden" name="createCustomerAfter" value="@((ViewData["CreateCustomerAfter"] as bool?) == true)" />
        <input type="hidden" name="bookingReturnUrl" value="@(ViewData["BookingReturnUrl"]?.ToString())" />
        <div asp-validation-summary="All" class="user-validation"></div>

        <div class="user-field">
            <label asp-for="Username"></label>
            <input asp-for="Username" class="user-input" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="user-field">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="user-input" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="user-field user-field--wide">
            <label asp-for="PasswordHash"></label>
            <input asp-for="PasswordHash" class="user-input" spellcheck="false" />
            <small class="user-helper">The API expects the stored hash value rather than a plain-text password.</small>
            <span asp-validation-for="PasswordHash" class="text-danger"></span>
        </div>

        <div class="user-field">
            <label asp-for="RoleId"></label>
            <select asp-for="RoleId" asp-items="Model.RoleOptions" class="user-input"></select>
            <span asp-validation-for="RoleId" class="text-danger"></span>
        </div>

        <div class="user-field">
            <label asp-for="StatusId"></label>
            <select asp-for="StatusId" asp-items="Model.StatusOptions" class="user-input"></select>
            <span asp-validation-for="StatusId" class="text-danger"></span>
        </div>

        <div class="user-form-actions">
            <button type="submit" class="user-button">@Model.SubmitLabel</button>
            <a asp-action="Index" class="user-button user-button--ghost">Cancel</a>
        </div>
    </form>
</section>