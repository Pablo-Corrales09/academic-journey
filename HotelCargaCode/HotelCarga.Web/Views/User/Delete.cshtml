@model HotelCarga.Models.Users.UserListItemViewModel

@{
    ViewData["Title"] = $"Delete {Model.Username}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
}

<div class="user-shell" data-page="delete">
    <section class="user-hero user-hero--compact" data-animate>
        <div class="user-hero__content">
            <span class="user-eyebrow">Removal Review</span>
            <h1>Delete @Model.Username?</h1>
            <p>This action removes the account from the API-backed user directory. Review the key navigation fields before confirming.</p>
        </div>
    </section>

    <section class="user-surface" data-animate>
        <div class="user-surface__header">
            <div>
                <span class="user-section-tag">Deletion Check</span>
                <h2>Account summary</h2>
            </div>
            <p>Once removed, the record will no longer appear in the MVC client.</p>
        </div>

        <div class="user-detail-grid user-detail-grid--two">
            <article class="user-detail-card">
                <span>Username</span>
                <strong>@Model.Username</strong>
            </article>
            <article class="user-detail-card">
                <span>Email</span>
                <strong>@Model.Email</strong>
            </article>
            <article class="user-detail-card">
                <span>Role</span>
                <strong>@Model.RoleName</strong>
            </article>
            <article class="user-detail-card">
                <span>Status</span>
                <strong>@Model.StatusName</strong>
            </article>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="user-form-actions">
            @Html.AntiForgeryToken()
            <button type="submit" class="user-button user-button--danger">Delete User</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="user-button user-button--ghost">Cancel</a>
        </form>
    </section>
</div>

@section Scripts {
    <script src="~/js/user/delete.js" asp-append-version="true"></script>
}