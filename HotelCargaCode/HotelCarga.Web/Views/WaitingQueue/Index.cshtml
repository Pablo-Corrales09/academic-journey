@model HotelCarga.Models.WaitingQueue.WaitingQueueIndexViewModel

@{
    ViewData["Title"] = "Waiting Queue";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
}

<div class="user-shell booking-shell" data-page="waiting-queue-index">
    <section class="user-hero" data-animate>
        <div class="user-hero__content">
            <h1>Waiting Queue Management</h1>
            <p>Pending confirmation requests, FIFO visibility, and date-range filtering in one view.</p>
        </div>
    </section>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert" data-animate>@errorMessage</div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-warning" role="alert" data-animate>
            @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@modelError.ErrorMessage</div>
            }
        </div>
    }

    <section class="card mb-3" data-animate>
        <div class="card-body p-4">
            <form asp-action="Index" method="get" class="row gx-2 gy-2 align-items-end">
                <div class="col-md-3 col-sm-6">
                    <label asp-for="Filters.FromDate" class="form-label form-label-sm mb-1"></label>
                    <input asp-for="Filters.FromDate" type="date" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3 col-sm-6">
                    <label asp-for="Filters.ToDate" class="form-label form-label-sm mb-1"></label>
                    <input asp-for="Filters.ToDate" type="date" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3 col-sm-6">
                    <label asp-for="Filters.StatusName" class="form-label form-label-sm mb-1"></label>
                    <select asp-for="Filters.StatusName" class="form-select form-select-sm">
                        <option value="PENDING">PENDING</option>
                        <option value="CONFIRMED">CONFIRMED</option>
                    </select>
                </div>
                <div class="col-md-3 col-sm-6 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary w-100">Apply</button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary w-100">Reset</a>
                </div>
            </form>
        </div>
    </section>

    <section class="card mb-3" data-animate>
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-3">
                <div>
                    <h2 class="mb-1">Reservas en cola</h2>
                </div>
                <span class="badge badge-info">@Model.Items.Count item(s)</span>
            </div>

            <div class="table-responsive mb-3" style="height: auto;">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Request #</th>
                            <th>Customer</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Requested Check In</th>
                            <th>Check Out</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Sin reservas pendientes.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Items)
                            {
                                var normalizedStatus = (item.StatusName ?? string.Empty).Trim().ToUpperInvariant();
                                var statusBadgeClass = normalizedStatus switch
                                {
                                    "CONFIRMED" => "badge badge-success",
                                    "PENDING" => "badge badge-warning text-dark",
                                    _ => "badge badge-secondary"
                                };

                                <tr>
                                    <td>@item.RequestNumber</td>
                                    <td>@item.CustomerName</td>
                                    <td>@item.RoomCategoryName</td>
                                    <td><span class="@statusBadgeClass">@normalizedStatus</span></td>
                                    <td>@item.RequestedCheckIn.ToString("yyyy-MM-dd")</td>
                                    <td>@(item.CheckOut?.ToString("yyyy-MM-dd") ?? "-")</td>
                                    <td>@(item.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

