<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HotelCarga</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{ var isLanding = (bool?)ViewData["LandingNav"] ?? false; }
    <header class="app-header @(isLanding ? "landing-header" : "")" data-navbar-header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light app-navbar">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Hotel Carga</a>
            
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link app-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        

                        @if (User.IsInRole("ADMIN"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle app-nav-link" href="#" id="adminDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Mantenimientos
                                </a>
                                <div class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <a class="dropdown-item" asp-area="" asp-controller="User" asp-action="Index">Usuarios</a>
                                    <a class="dropdown-item" asp-area="" asp-controller="Customer" asp-action="Index">Clientes</a>
                                    <a class="dropdown-item" asp-area="" asp-controller="Room" asp-action="Index">Habitaciones</a>
                                    <a class="dropdown-item" asp-area="" asp-controller="WaitingQueue" asp-action="Index">Cola de espera</a>
                                </div>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link app-nav-link" asp-area="" asp-controller="Booking" asp-action="Index">Reservas</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link app-nav-link" asp-area="" asp-controller="Home" asp-action="About">Nosotros</a>
                        </li>
                    </ul>

                    <form asp-controller="User" asp-action="Logout" method="post" class="form-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn app-btn app-btn--outline-danger">Logout</button>
                    </form>
                }
                else
                {
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link app-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link app-nav-link" asp-area="" asp-controller="Home" asp-action="About">Nosotros</a>
                        </li>
                    </ul>

                    <a asp-controller="User" asp-action="Login" class="btn app-btn app-btn--primary landing-login-btn">Login</a>
                }
            </div>
        </div>
    </nav>
    </header>
    <div class="container app-main-container" data-page-transition-container>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; Hotel Carga - Desarrollado por Pablo Corrales Padilla - devpablo.corrales@gmail.com - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <a class="floating-whatsapp-btn"
       href="https://wa.me/50688888888"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="Chat on WhatsApp">
        <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <path d="M19.11 17.27c-.28-.14-1.64-.81-1.89-.9-.25-.09-.43-.14-.61.14s-.7.9-.86 1.09c-.16.19-.32.21-.59.07-.28-.14-1.16-.43-2.22-1.36-.82-.73-1.38-1.64-1.54-1.91-.16-.28-.02-.43.12-.57.13-.13.28-.33.43-.49.14-.16.19-.28.28-.47.09-.19.05-.35-.02-.49-.07-.14-.61-1.47-.84-2.01-.22-.53-.44-.46-.61-.46h-.52c-.19 0-.49.07-.75.35s-.98.95-.98 2.31.99 2.67 1.13 2.86c.14.19 1.95 2.98 4.72 4.18.66.28 1.18.45 1.58.58.66.21 1.25.18 1.72.11.52-.08 1.64-.67 1.87-1.31.23-.64.23-1.19.16-1.31-.06-.12-.24-.19-.52-.33zM16.02 4.01c-6.61 0-11.97 5.36-11.97 11.97 0 2.1.55 4.16 1.58 5.97L4 28l6.25-1.64c1.73.95 3.68 1.45 5.77 1.45h.01c6.61 0 11.97-5.36 11.97-11.97 0-3.2-1.24-6.2-3.5-8.47-2.26-2.26-5.27-3.5-8.48-3.5zm0 21.78h-.01c-1.78 0-3.52-.48-5.05-1.4l-.36-.22-3.71.97.99-3.62-.24-.37a9.98 9.98 0 0 1-1.54-5.31c0-5.5 4.48-9.98 9.99-9.98 2.66 0 5.15 1.04 7.03 2.91a9.87 9.87 0 0 1 2.91 7.04c0 5.51-4.48 9.98-10.01 9.98z"></path>
        </svg>
    </a>

    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
