@model HotelCarga.Models.Bookings.BookingFormViewModel

@{
    ViewData["Title"] = Model.PageTitle;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
    <style>
        .modal-backdrop {
            z-index: 1040 !important;
        }

        .modal {
            z-index: 1060 !important;
        }
    </style>
}

<div class="user-shell booking-shell" data-page="booking-form">
    <section class="user-hero user-hero--compact" data-animate>
        <div class="user-hero__content">
            <h1>@Model.PageTitle</h1>
            <p>@Model.IntroText</p>
        </div>
    </section>

    <partial name="_BookingForm" model="Model" />
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/booking/form.js" asp-append-version="true"></script>
    <script>
        (function () {
            const form = document.getElementById('booking-form');
            if (!form) return;

            $('#bookingConfirmModal, #bookingQueueModal, #bookingSuccessModal').appendTo('body');

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                $('#bookingConfirmModal').modal('show');
            });

            document.getElementById('confirm-submit-btn').addEventListener('click', async function () {
                $('#bookingConfirmModal').modal('hide');
                await submitBooking(false);
            });

            document.getElementById('queue-confirm-btn').addEventListener('click', async function () {
                $('#bookingQueueModal').modal('hide');
                await submitBooking(true);
            });

            document.getElementById('success-ok-btn').addEventListener('click', function () {
                window.location.href = '@Url.Action("List", "Booking")';
            });

            $('#bookingSuccessModal').on('hidden.bs.modal', function () {
                window.location.href = '@Url.Action("List", "Booking")';
            });

            async function submitBooking(addToQueue) {
                const formData = new FormData(form);
                if (addToQueue) {
                    formData.set('addToQueueIfUnavailable', 'true');
                }
                const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': token || ''
                        }
                    });

                    const data = await response.json();

                    if (data.success) {
                        const msg = document.getElementById('success-modal-message');
                        if (msg) {
                            msg.textContent = data.queued
                                ? (data.message || 'Añadido a la cola de reservas exitosamente.')
                                : 'Reserva creada exitosamente.';
                        }
                        $('#bookingSuccessModal').modal('show');
                    } else if (data.unavailable) {
                        $('#bookingQueueModal').modal('show');
                    } else {
                        const errorDiv = form.querySelector('.user-validation');
                        if (errorDiv) {
                            errorDiv.textContent = data.message || 'Ocurrió un error.';
                            errorDiv.style.display = 'block';
                        } else {
                            alert(data.message || 'Ocurrió un error.');
                        }
                    }
                } catch {
                    alert('Error de red. Por favor, inténtelo de nuevo.');
                }
            }
        })();
    </script>
}

<div class="modal fade" id="bookingConfirmModal" tabindex="-1" role="dialog" aria-labelledby="bookingConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bookingConfirmModalLabel">Confirmar Reserva</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                ¿Desea crear esta reserva con los detalles proporcionados?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Volver</button>
                <button type="button" class="btn btn-primary" id="confirm-submit-btn">Confirmar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bookingQueueModal" tabindex="-1" role="dialog" aria-labelledby="bookingQueueModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bookingQueueModalLabel">Habitación No Disponible</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                La habitación seleccionada no está disponible para las fechas elegidas. ¿Desea ser agregado a la cola de espera?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">No, Cancelar</button>
                <button type="button" class="btn btn-primary" id="queue-confirm-btn">Sí, Agregar a la Cola</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bookingSuccessModal" tabindex="-1" role="dialog" aria-labelledby="bookingSuccessModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bookingSuccessModalLabel">Éxito</h5>
            </div>
            <div class="modal-body">
                <p id="success-modal-message">Reserva creada con éxito.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="success-ok-btn">OK</button>
            </div>
        </div>
    </div>
</div>