@model HotelCarga.Models.Bookings.BookingFormViewModel

@{
    ViewData["Title"] = Model.PageTitle;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
    <style>
        .modal-backdrop {
            z-index: 1040 !important;
        }

        .modal {
            z-index: 1060 !important;
        }
    </style>
}

<div class="user-shell booking-shell" data-page="booking-form">
    <section class="user-hero user-hero--compact" data-animate>
        <div class="user-hero__content">
            <h1>@Model.PageTitle</h1>
            <p>@Model.IntroText</p>
        </div>
    </section>

    <partial name="_BookingForm" model="Model" />
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/booking/form.js" asp-append-version="true"></script>
    <script>
        (function () {
            const form = document.getElementById('booking-form');
            if (!form) return;
            let isSubmitting = false;

            $('#bookingConfirmModal, #bookingQueueModal, #bookingSuccessModal').appendTo('body');

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                $('#bookingConfirmModal').modal('show');
            });

            document.getElementById('confirm-submit-btn').addEventListener('click', async function () {
                $('#bookingConfirmModal').modal('hide');
                await submitBooking(false);
            });

            document.getElementById('queue-confirm-btn').addEventListener('click', async function () {
                $('#bookingQueueModal').modal('hide');
                await submitBooking(true);
            });

            document.getElementById('success-ok-btn').addEventListener('click', function () {
                window.location.href = '@Url.Action("List", "Booking")';
            });

            $('#bookingSuccessModal').on('hidden.bs.modal', function () {
                window.location.href = '@Url.Action("List", "Booking")';
            });

            async function submitBooking(addToQueue) {
                if (isSubmitting) return;
                isSubmitting = true;

                const confirmBtn = document.getElementById('confirm-submit-btn');
                const queueBtn = document.getElementById('queue-confirm-btn');
                if (confirmBtn) confirmBtn.disabled = true;
                if (queueBtn) queueBtn.disabled = true;

                const formData = new FormData(form);
                const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;
                
                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': token || ''
                        }
                    });

                    const data = await response.json();

                    // Handle new structured response with result_type
                    if (data.result_type === 'BOOKING_CREATED') {
                        // Success: Booking was created
                        const msg = document.getElementById('success-modal-message');
                        if (msg) {
                            msg.textContent = data.message || 'Reserva creada exitosamente.';
                        }
                        $('#bookingSuccessModal').modal('show');
                    } 
                    else if (data.result_type === 'ALTERNATIVE_ROOM_SUGGESTED') {
                        // Alternative room suggestion - show alternative options
                        showAlternativeRoomPrompt(data.alternative_room_suggested || data.alternativeRoom, data.message);
                    } 
                    else if (data.result_type === 'QUEUED_AND_PENDING_BOOKING_CREATED') {
                        // Success: Added to waiting queue
                        const msg = document.getElementById('success-modal-message');
                        if (msg) {
                            msg.textContent = data.message || 'Añadido a la cola de reservas exitosamente.';
                        }
                        $('#bookingSuccessModal').modal('show');
                    } 
                    else if (data.result_type === 'VALIDATION_ERROR') {
                        // Validation error - show error message
                        const errorDiv = form.querySelector('.user-validation');
                        if (errorDiv) {
                            errorDiv.textContent = data.message || 'Error de validación.';
                            errorDiv.style.display = 'block';
                        } else {
                            alert(data.message || 'Error de validación.');
                        }
                    } 
                    else {
                        // Unknown response type
                        const errorDiv = form.querySelector('.user-validation');
                        if (errorDiv) {
                            errorDiv.textContent = 'Respuesta inesperada del servidor.';
                            errorDiv.style.display = 'block';
                        } else {
                            alert('Respuesta inesperada del servidor.');
                        }
                    }
                } catch (error) {
                    console.error('Booking submission error:', error);
                    alert('Error de red. Por favor, inténtelo de nuevo.');
                } finally {
                    isSubmitting = false;
                    if (confirmBtn) confirmBtn.disabled = false;
                    if (queueBtn) queueBtn.disabled = false;
                }
            }

            function showAlternativeRoomPrompt(alternativeRoom, message) {
                // Show modal with alternative room details
                const modal = document.getElementById('bookingAlternativeModal');
                if (!modal) {
                    // Create modal if it doesn't exist
                    const modalHtml = `
                        <div class="modal fade" id="bookingAlternativeModal" tabindex="-1" role="dialog">
                            <div class="modal-dialog modal-dialog-centered" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Habitación Alternativa Disponible</h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        <p id="alternativeMessage"></p>
                                        <div id="alternativeDetails" class="mt-3"></div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                                        <button type="button" class="btn btn-primary" id="acceptAlternativeBtn">Aceptar Alternativa</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    document.body.insertAdjacentHTML('beforeend', modalHtml);
                }
                
                // Populate modal with alternative room info
                document.getElementById('alternativeMessage').textContent = message;
                const detailsDiv = document.getElementById('alternativeDetails');
                detailsDiv.innerHTML = `
                    <p><strong>Habitación Original Solicitada:</strong> ${alternativeRoom.original_requested_room_number}</p>
                    <p><strong>Alternativa Disponible:</strong> Habitación ${alternativeRoom.alternative_room_number}</p>
                    <p><strong>Categoría:</strong> ${alternativeRoom.room_category_name}</p>
                    <p><strong>Tarifa por Noche:</strong> $${alternativeRoom.alternative_nightly_rate}</p>
                    <p><strong>Piso:</strong> ${alternativeRoom.floor_number}</p>
                `;
                
                // Show modal
                $('#bookingAlternativeModal').modal('show');
                
                // Handle acceptance: call ConfirmAlternative endpoint directly
                document.getElementById('acceptAlternativeBtn').onclick = async () => {
                    $('#bookingAlternativeModal').modal('hide');

                    const customerId = form.querySelector('[name="CustomerId"]')?.value;
                    const checkIn = form.querySelector('[name="CheckIn"]')?.value;
                    const checkOut = form.querySelector('[name="CheckOut"]')?.value;
                    const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;

                    try {
                        const params = new URLSearchParams({
                            customerId: customerId,
                            alternativeRoomId: alternativeRoom.alternative_room_id,
                            checkIn: checkIn,
                            checkOut: checkOut
                        });
                        const confirmAlternativeUrl = '@Url.Action("ConfirmAlternativeRoom", "Booking")';
                        const resp = await fetch(`${confirmAlternativeUrl}?${params}`, {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'RequestVerificationToken': token || ''
                            }
                        });
                        const data = await resp.json();
                        if (data.success) {
                            const msg = document.getElementById('success-modal-message');
                            if (msg) msg.textContent = data.message || 'Reserva creada exitosamente con habitación alternativa.';
                            $('#bookingSuccessModal').modal('show');
                        } else {
                            const errorDiv = form.querySelector('.user-validation');
                            if (errorDiv) {
                                errorDiv.textContent = data.message || 'No se pudo crear la reserva con la habitación alternativa.';
                                errorDiv.style.display = 'block';
                            } else {
                                alert(data.message || 'No se pudo crear la reserva con la habitación alternativa.');
                            }
                        }
                    } catch (err) {
                        console.error('Error confirming alternative room:', err);
                        alert('Error al confirmar la habitación alternativa. Por favor, inténtelo de nuevo.');
                    }
                };
            }
        })();
    </script>
}

<div class="modal fade" id="bookingConfirmModal" tabindex="-1" role="dialog" aria-labelledby="bookingConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bookingConfirmModalLabel">Confirmar Reserva</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                ¿Desea crear esta reserva con los detalles proporcionados?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Volver</button>
                <button type="button" class="btn btn-primary" id="confirm-submit-btn">Confirmar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bookingQueueModal" tabindex="-1" role="dialog" aria-labelledby="bookingQueueModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bookingQueueModalLabel">Habitación No Disponible</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                La habitación seleccionada no está disponible para las fechas elegidas. ¿Desea ser agregado a la cola de espera?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">No, Cancelar</button>
                <button type="button" class="btn btn-primary" id="queue-confirm-btn">Sí, Agregar a la Cola</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bookingSuccessModal" tabindex="-1" role="dialog" aria-labelledby="bookingSuccessModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bookingSuccessModalLabel">Éxito</h5>
            </div>
            <div class="modal-body">
                <p id="success-modal-message">Reserva creada con éxito.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="success-ok-btn">OK</button>
            </div>
        </div>
    </div>
</div>