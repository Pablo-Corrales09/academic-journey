@model HotelCarga.Models.Bookings.BookingIndexViewModel

@{
    ViewData["Title"] = "Booking Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/booking/index.css" asp-append-version="true" />
}

<div class="user-shell booking-shell" data-page="booking-index-home">
    <section class="user-hero" data-animate>
        <div class="user-hero__content">
            <h1 style="margin: 10px 0;">Encuentra tu habitación perfecta</h1>
            <p>Explora los tipos de habitaciones disponibles con tarifas por noche, luego crea una reserva o consulta la lista completa de reservas.</p>
            <div class="user-hero__actions" style="display: flex; justify-content: space-between;">
                <a asp-action="Create" class="user-button">Crear reserva</a>
                <a asp-action="List" class="user-button user-button--ghost">Ver todas las reservas</a>
            </div>
        </div>
    </section>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="user-alert user-alert--success" data-animate>@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="user-alert user-alert--error" data-animate>@errorMessage</div>
    }

    <section class="user-surface" data-animate>
        <div class="user-surface__header">
            <div>
                <h2>Buscar una reserva</h2>
            </div>
            <p>Buscar por número de reserva o nombre del cliente.</p>
        </div>

        <form asp-action="List" method="get" class="user-filter-grid">
        <div class="search-group">
            <div class="user-field user-field--wide">
                <input id="search-term" name="SearchTerm" value="@Model.SearchTerm" class="user-input" placeholder="Número de reserva o nombre del cliente" />
            </div>
            
            <div class="user-form-actions--inline">
                <button type="submit" class="user-button">Buscar</button>
            </div>
        </div>
        </form>
    </section>

        <section class="room-surface mb-5 p-3" data-animate>
        <div class="room-surface__header mb-4 border-bottom pb-2 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="h5 mb-0">Listado de Unidades Operativas</h2>
                <p class="small text-muted mb-0">@Model.Rooms.Count habitaciones registradas.</p>
            </div>
        </div>

        @if (Model.Rooms.Count == 0)
        {
            <div class="text-center py-5">
                <i class="fas fa-door-closed h1 text-muted opacity-50"></i>
                <p class="mt-2 text-muted">No hay resultados para esta búsqueda.</p>
            </div>
        }
        else
        {
            <div class="row mx-0">
                @foreach (var room in Model.Rooms)
                {
                    var categoria = room.CategoryName?.ToUpper() ?? "";
                    string urlImagen = categoria switch
                    {
                        var c when c.Contains("SENCILLA") => "https://images.unsplash.com/photo-1505691938895-1758d7eaa511?q=80&w=600&auto=format&fit=crop",
                        var c when c.Contains("DELUXE")   => "https://images.unsplash.com/photo-1566665797739-1674de7a421a?q=80&w=600&auto=format&fit=crop",
                        var c when c.Contains("PREMIUM")  => "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?q=80&w=600&auto=format&fit=crop",
                        var c when c.Contains("SUITE")    => "https://images.unsplash.com/photo-1591088398332-8a7791972843?q=80&w=600&auto=format&fit=crop",
                        _                                 => "https://images.unsplash.com/photo-1590490359683-658d3d23f972?q=80&w=600&auto=format&fit=crop" 
                    };

                    <div class="col-12 col-md-6 col-lg-4 mb-4 px-2">
                        <article class="card h-100 shadow-sm border-0" style="border-radius: 12px; overflow: hidden; background: #fff;">
                            <div style="height: 180px; width: 100%; position: relative; background: #eee;">
                                <img src="@urlImagen" 
                                     alt="Habitación" 
                                     style="width: 100%; height: 100%; object-fit: cover;"
                                     onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=600&auto=format&fit=crop';" />
                                
                                <div style="position: absolute; top: 10px; right: 10px;">
                                    @{
                                        var status = room.StatusName?.ToUpper();
                                        var badgeColor = status == "AVAILABLE" ? "badge-success" : (status == "OCCUPIED" ? "badge-danger" : "badge-warning");
                                    }
                                    <span class="badge @badgeColor px-3 py-2 shadow-sm">@room.StatusName</span>
                                </div>
                            </div>

                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h3 class="h6 font-weight-bold mb-0 text-dark">@room.CategoryName</h3>
                                    <span class="badge badge-light border text-muted px-2">#@room.RoomNumber</span>
                                </div>

                                <p class="small text-muted flex-grow-1" style="line-height: 1.3;">
                                    Ubicada en el <strong>Piso @(room.FloorNumber ?? 1)</strong>. Espacio diseñado para la eficiencia y el confort.
                                </p>

                                <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded mb-3">
                                    <small class="text-muted font-weight-bold">Tarifa Diaria:</small>
                                    <strong class="text-primary h6 mb-0">@room.NightlyRate.ToString("C")</strong>
                                </div>

                                <div class="d-flex flex-column justify-content-between border-top pt-3" style="min-height: 124px;">
                                    <div class="d-flex flex-column">
                                        <a asp-controller="Booking"
                                           asp-action="BookingCreate"
                                           asp-route-roomId="@room.Id"
                                           asp-route-roomNumber="@room.RoomNumber"
                                           asp-route-roomType="@room.CategoryName"
                                           class="btn btn-primary btn-sm px-4 mb-2">Reservar</a>
                                        <a asp-controller="Room"
                                           asp-action="Details"
                                           asp-route-id="@room.Id"
                                           class="btn btn-outline-primary btn-sm px-4">Ver información</a>
                                    </div>
                                    <div class="btn-group align-self-end mt-2">
                                        <a asp-controller="Room" asp-action="Edit" asp-route-id="@room.Id" class="btn btn-outline-secondary btn-sm border-0"><i class="fas fa-edit"></i></a>
                                        <a asp-controller="Room" asp-action="Delete" asp-route-id="@room.Id" class="btn btn-outline-danger btn-sm border-0 ml-1"><i class="fas fa-trash"></i></a>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </section>


    <section class="landing-section landing-section--compact" data-reveal>
    <div class="landing-section__header text-center mb-4">
        <span class="landing-kicker">COMODIDADES Y SERVICIOS</span>
        <h2>Todo para su estancia</h2>
    </div>

    <div class="services-slider-container">
        <div class="services-slider-wrapper">
            <article class="landing-service-card active">
                <div class="landing-service-icon"><i class="bi bi-wifi"></i></div>
                <h3>Wi-Fi de alta velocidad</h3>
                <p>Conexión estable y rápida en cada rincón.</p>
            </article>
            
            <article class="landing-service-card">
                <div class="landing-service-icon"><i class="bi bi-water"></i></div>
                <h3>Piscina estilo resort</h3>
                <p>Zonas de descanso y relajación total.</p>
            </article>

            <article class="landing-service-card">
                <div class="landing-service-icon"><i class="bi bi-egg-fried"></i></div>
                <h3>Restaurante gourmet</h3>
                <p>Cocina local e internacional refinada.</p>
            </article>

            <article class="landing-service-card">
                <div class="landing-service-icon"><i class="bi bi-activity"></i></div>
                <h3>Gimnasio moderno</h3>
                <p>Entrenamiento completo y bienestar.</p>
            </article>

            <article class="landing-service-card">
                <div class="landing-service-icon"><i class="bi bi-clock-history"></i></div>
                <h3>Room service 24/7</h3>
                <p>Soporte continuo para sus necesidades.</p>
            </article>

            <article class="landing-service-card">
                <div class="landing-service-icon"><i class="bi bi-airplane"></i></div>
                <h3>Traslados</h3>
                <p>Recogida y traslado sin contratiempos.</p>
            </article>
        </div>

        <div class="slider-controls">
            <button type="button" class="slider-btn prev" aria-label="Servicio anterior"><i class="bi bi-chevron-left"></i></button>
            <button type="button" class="slider-btn next" aria-label="Servicio siguiente"><i class="bi bi-chevron-right"></i></button>
        </div>
    </div>
</section>


</div>

@section Scripts {
    <script src="~/js/home/index.js" asp-append-version="true"></script>
    <script src="~/js/booking/index.js" asp-append-version="true"></script>
}