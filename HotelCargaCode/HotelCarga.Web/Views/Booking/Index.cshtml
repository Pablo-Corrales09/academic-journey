@model HotelCarga.Models.Bookings.BookingIndexViewModel

@{
    ViewData["Title"] = "Booking Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
}

<div class="user-shell booking-shell" data-page="booking-index-home">
    <section class="user-hero" data-animate>
        <div class="user-hero__content">
            <h1 style="margin: 10px 0;">Encuentra tu habitación perfecta</h1>
            <p>Explora los tipos de habitaciones disponibles con tarifas por noche, luego crea una reserva o consulta la lista completa de reservas.</p>
            <div class="user-hero__actions">
                <a asp-action="Create" class="user-button">Crear reserva</a>
                <a asp-action="List" class="user-button user-button--ghost">Ver todas las reservas</a>
            </div>
        </div>
    </section>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="user-alert user-alert--success" data-animate>@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="user-alert user-alert--error" data-animate>@errorMessage</div>
    }

    <section class="user-surface" data-animate>
        <div class="user-surface__header">
            <div>
                <h2>Buscar una reserva</h2>
            </div>
            <p>Buscar por número de reserva o nombre del cliente.</p>
        </div>

        <form asp-action="List" method="get" class="user-filter-grid">
        <div class="search-group">
            <div class="user-field user-field--wide">
                <input id="search-term" name="SearchTerm" value="@Model.SearchTerm" class="user-input" placeholder="Número de reserva o nombre del cliente" />
            </div>
            
            <div class="user-form-actions--inline">
                <button type="submit" class="user-button">Buscar</button>
            </div>
        </div>
        </form>
    </section>

    <section class="user-surface" data-animate>
        <div class="user-surface__header">
            <div>
                <h2>Categorías y precios disponibles</h2>
            </div>
        </div>

        @if (!Model.IsApiAvailable)
        {
            <div class="user-empty-state">
                <h3>Categorías no disponibles por el momento.</h3>
                <p>Inicia el servicio y actualiza esta página.</p>
            </div>
        }
        else if (Model.RoomTypes.Count == 0)
        {
            <div class="user-empty-state">
                <h3>No hay categorías disponibles.</h3>
                <p>No hay categorías disponibles para reservar en este momento.</p>
            </div>
        }
        else
        {
            <div class="user-card-grid">
                @foreach (var roomType in Model.RoomTypes)
                {
                    <article class="user-card" data-animate>
                        <div class="user-card__header">
                            <div>
                                <span class="user-chip">@roomType.CategoryName</span>
                                <h3>@roomType.AvailableRooms habitación(es) disponibles</h3>
                            </div>
                        </div>
                        <p>@roomType.Description</p>
                        <dl class="user-card__meta">
                            <div>
                                <dt>Tarifa por noche</dt>
                                <dd>
                                    @if (roomType.NightlyRateFrom == roomType.NightlyRateTo)
                                    {
                                        @roomType.NightlyRateFrom.ToString("C")
                                    }
                                    else
                                    {
                                        @($"{roomType.NightlyRateFrom:C} - {roomType.NightlyRateTo:C}")
                                    }
                                </dd>
                            </div>
                        </dl>
                    </article>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/booking/index.js" asp-append-version="true"></script>
}