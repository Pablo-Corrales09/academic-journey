@model HotelCarga.Models.Bookings.BookingIndexViewModel

@{
    ViewData["Title"] = "Booking Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
}

<div class="user-shell booking-shell" data-page="booking-index-home">
    <section class="user-hero" data-animate>
        <div class="user-hero__content">
            <span class="user-eyebrow">Reservation Desk</span>
            <h1>Book by room type and schedule</h1>
            <p>Browse available room types with nightly rates, then create a booking or check the full booking list.</p>
            <div class="user-hero__actions">
                <a asp-action="Create" class="user-button">Create Booking</a>
                <a asp-action="List" class="user-button user-button--ghost">Check All Bookings</a>
            </div>
        </div>
    </section>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="user-alert user-alert--success" data-animate>@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="user-alert user-alert--error" data-animate>@errorMessage</div>
    }

    <section class="user-surface" data-animate>
        <div class="user-surface__header">
            <div>
                <span class="user-section-tag">Quick Search</span>
                <h2>Find a booking</h2>
            </div>
            <p>Search by reserve number or customer name.</p>
        </div>

        <form asp-action="List" method="get" class="user-filter-grid">
            <div class="user-field user-field--wide">
                <label for="search-term">Search</label>
                <input id="search-term" name="SearchTerm" value="@Model.SearchTerm" class="user-input" placeholder="Reserve number or customer name" />
            </div>
            <div class="user-form-actions user-form-actions--inline">
                <button type="submit" class="user-button">Search</button>
            </div>
        </form>
    </section>

    <section class="user-surface" data-animate>
        <div class="user-surface__header">
            <div>
                <span class="user-section-tag">Room Types</span>
                <h2>Available categories and rates</h2>
            </div>
            <p>Room type overview only. Individual room status is intentionally hidden here.</p>
        </div>

        @if (!Model.IsApiAvailable)
        {
            <div class="user-empty-state">
                <h3>Room types unavailable right now.</h3>
                <p>Start HotelCarga.ApiModel and refresh this page.</p>
            </div>
        }
        else if (Model.RoomTypes.Count == 0)
        {
            <div class="user-empty-state">
                <h3>No room types available.</h3>
                <p>There are no available categories for booking at this moment.</p>
            </div>
        }
        else
        {
            <div class="user-card-grid">
                @foreach (var roomType in Model.RoomTypes)
                {
                    <article class="user-card" data-animate>
                        <div class="user-card__header">
                            <div>
                                <span class="user-chip">@roomType.CategoryName</span>
                                <h3>@roomType.AvailableRooms room(s) available</h3>
                            </div>
                        </div>
                        <p>@roomType.Description</p>
                        <dl class="user-card__meta">
                            <div>
                                <dt>Nightly Rate</dt>
                                <dd>
                                    @if (roomType.NightlyRateFrom == roomType.NightlyRateTo)
                                    {
                                        @roomType.NightlyRateFrom.ToString("C")
                                    }
                                    else
                                    {
                                        @($"{roomType.NightlyRateFrom:C} - {roomType.NightlyRateTo:C}")
                                    }
                                </dd>
                            </div>
                        </dl>
                    </article>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/booking/index.js" asp-append-version="true"></script>
}