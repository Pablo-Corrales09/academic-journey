@model HotelCarga.Models.Customers.CustomerListItemViewModel

@{
    ViewData["Title"] = $"Eliminar a {Model.FirstName} {Model.LastName}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
}

<div class="user-shell customer-shell" data-page="customer-delete">
    <section class="user-hero user-hero--compact" data-animate>
        <div class="user-hero__content">
            <h1>¿Eliminar a @Model.FirstName @Model.LastName?</h1>
            <p>Esta operación borrará permanentemente el perfil del cliente del registro general.</p>
        </div>
    </section>

    <section class="user-surface" data-animate>
        <div class="user-surface__header">
            <div>
                <span class="user-section-tag">Verificación</span>
                <h2>Resumen del cliente</h2>
            </div>
            <p>Revise los datos antes de confirmar que desea borrar este registro.</p>
        </div>

        <div class="user-detail-grid user-detail-grid--two">
            <article class="user-detail-card">
                <span>Documento</span>
                <strong>@Model.DocumentNumber</strong>
            </article>
            <article class="user-detail-card">
                <span>Teléfono</span>
                <strong>@Model.Phone</strong>
            </article>
            <article class="user-detail-card">
                <span>Usuario</span>
                <strong>@Model.Username</strong>
            </article>
            <article class="user-detail-card">
                <span>Estado</span>
                <strong>@Model.StatusName</strong>
            </article>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="user-form-actions">
            @Html.AntiForgeryToken()
            <button type="submit" class="user-button user-button--danger my-2">Eliminar Cliente</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="user-button user-button--ghost">Cancelar</a>
        </form>
    </section>
</div>

@section Scripts {
    <script src="~/js/customer/delete.js" asp-append-version="true"></script>
}