@model HotelCarga.Models.Customers.CustomerFormViewModel

@{
    // Título de la pestaña del navegador
    ViewData["Title"] = "Gestión de Clientes"; 
}

@section Styles {
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
}

<div class="user-shell customer-shell" data-page="customer-form">
    <section class="user-hero user-hero--compact" data-animate>
        <div class="user-hero__content">
            
            <h1>Edición de cliente</h1>
            
            <p>Por favor, complete los datos a continuación para mantener actualizada la ficha del cliente.</p>
        </div>
    </section>

    @* El formulario interno con los campos de datos *@
    <partial name="_CustomerForm" model="Model" />
</div>

@section Scripts {
    <script src="~/js/customer/form.js" asp-append-version="true"></script>
}