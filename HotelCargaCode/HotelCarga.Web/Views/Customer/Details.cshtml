@model HotelCarga.Models.Customers.CustomerDetailsViewModel

@{
    ViewData["Title"] = $"Customer {Model.Customer.FirstName} {Model.Customer.LastName}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer/details.css" asp-append-version="true" />
}

<div class="user-shell customer-shell" data-page="customer-details">
    <section class="user-hero user-hero--compact" data-animate>
        <div class="user-hero__content">
            <h1>@Model.Customer.FirstName @Model.Customer.LastName</h1>
            <p>N° documento <strong>@Model.Customer.DocumentNumber</strong> </p>
            <div class="user-hero__actions">
                <a asp-action="Update" asp-route-id="@Model.Customer.Id" class="user-button">Actualizar cliente</a>
                <a asp-action="Index" class="user-button user-button--ghost">Volver a Clientes</a>
            </div>
        </div>
    </section>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="user-alert user-alert--success" data-animate>@successMessage</div>
    }

    <section class="user-surface" data-animate>
        <div class="user-surface__header">
            <div>
                <span class="user-section-tag">Resumen</span>
                <h2>Detalles de identidad y contacto</h2>
            </div>
        </div>

        <div class="user-detail-grid">
            <article class="user-detail-card">
                <span>Correo electrónico</span>
                <strong>@Model.Customer.Email</strong>
            </article>
            <article class="user-detail-card">
                <span>Teléfono</span>
                <strong>@Model.Customer.Phone</strong>
            </article>
            <article class="user-detail-card">
                <span>Ubicación</span>
                <strong>@Model.Customer.City, @Model.Customer.Country</strong>
                <p>@Model.Customer.Address</p>
            </article>
        </div>
    </section>

    <section class="user-surface" data-animate>
        <div class="user-surface__header">
            <div>
                <h2>Resumen</h2>
            </div>
            <p>Historial de reservas.</p>
        </div>

        <div class="user-detail-grid user-detail-grid--two customer-related-grid">
            <article class="user-detail-card customer-related-card">
                <div class="customer-related-card__media">
                    <img src="~/images/customer/booking-overview.svg" alt="Resumen visual de reservas relacionadas" />
                </div>
                <div class="customer-related-card__content">
                <span class="customer-related-card__label">Reservas relacionadas</span>
                <strong class="customer-related-card__count">@Model.RelatedBookings.Count</strong>
                @if (Model.RelatedBookings.Count == 0)
                {
                    <p class="customer-related-empty">No hay reservas relacionadas.</p>
                }
                else
                {
                    <ul class="customer-related-list">
                        @foreach (var booking in Model.RelatedBookings)
                        {
                            <li class="customer-related-item">
                                <strong>@booking.ReserveNumber</strong> - @booking.StatusName
                                <div class="customer-related-meta">@booking.RoomLabel</div>
                                <div class="customer-related-meta">@booking.CheckIn.ToString("dd MMM yyyy") - @booking.CheckOut.ToString("dd MMM yyyy")</div>
                            </li>
                        }
                    </ul>
                }
                </div>
            </article>
            <article class="user-detail-card customer-related-card">
                <div class="customer-related-card__media">
                    <img src="~/images/customer/history-timeline.svg" alt="Línea de tiempo del historial de reservas" />
                </div>
                <div class="customer-related-card__content">
                <span class="customer-related-card__label">Historial de reservas</span>
                <strong class="customer-related-card__count">@Model.RelatedBookingHistories.Count</strong>
                @if (Model.RelatedBookingHistories.Count == 0)
                {
                    <p class="customer-related-empty">No hay eventos de historial relacionados.</p>
                }
                else
                {
                    <ul class="customer-related-list">
                        @foreach (var history in Model.RelatedBookingHistories)
                        {
                            <li class="customer-related-item">
                                <strong>@history.ActionType</strong> - @history.StatusName
                                <div class="customer-related-meta">@history.CheckIn.ToString("dd MMM yyyy") - @history.CheckOut.ToString("dd MMM yyyy")</div>
                                @if (history.LoggedAt.HasValue)
                                {
                                    <div class="customer-related-meta">Registrado: @history.LoggedAt.Value.ToString("dd MMM yyyy HH:mm")</div>
                                }
                                @if (history.TotalPrice.HasValue)
                                {
                                    <div class="customer-related-meta">Total: @history.TotalPrice.Value.ToString("C")</div>
                                }
                            </li>
                        }
                    </ul>
                }
                </div>
            </article>
            <article class="user-detail-card customer-related-card">
                <div class="customer-related-card__media">
                    <img src="~/images/customer/queue-status.svg" alt="Estado y categoría de solicitudes en lista de espera" />
                </div>
                <div class="customer-related-card__content">
                <span class="customer-related-card__label">Solicitudes en cola</span>
                <strong class="customer-related-card__count">@Model.RelatedWaitingQueues.Count</strong>
                @if (Model.RelatedWaitingQueues.Count == 0)
                {
                    <p class="customer-related-empty">No hay solicitudes en lista de espera.</p>
                }
                else
                {
                    <ul class="customer-related-list">
                        @foreach (var queue in Model.RelatedWaitingQueues)
                        {
                            <li class="customer-related-item">
                                <strong>@queue.RequestNumber</strong> - @queue.RoomCategoryName
                                <div class="customer-related-meta">Estado: @queue.StatusName</div>
                                <div class="customer-related-meta">
                                @queue.RequestedCheckIn.ToString("dd MMM yyyy")
                                @if (queue.CheckOut.HasValue)
                                {
                                    <span> - @queue.CheckOut.Value.ToString("dd MMM yyyy")</span>
                                }
                                </div>
                            </li>
                        }
                    </ul>
                }
                </div>
            </article>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/customer/details.js" asp-append-version="true"></script>
}