@model HotelCarga.Models.Customers.CustomerFormViewModel

<section class="user-surface" data-animate>
    <div class="user-surface__header">
        <div>
            <h2>Información del cliente</h2>
        </div>
    </div>

    <form asp-action="@ViewContext.RouteData.Values["action"]" asp-route-id="@Model.Id" method="post" class="user-form-grid">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="UserId" type="hidden" />
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="user-validation"></div>

        <div class="user-field">
            <label asp-for="DocumentNumber">Número de Documento</label>
            <input asp-for="DocumentNumber" class="user-input" />
            <span asp-validation-for="DocumentNumber" class="text-danger"></span>
        </div>

        <div class="user-field">
            <label asp-for="FirstName">Nombre</label>
            <input asp-for="FirstName" class="user-input" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="user-field">
            <label asp-for="LastName">Apellidos</label>
            <input asp-for="LastName" class="user-input" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="user-field">
            <label asp-for="Phone">Teléfono de Contacto</label>
            <input asp-for="Phone" class="user-input" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="user-field user-field--wide">
            <label asp-for="Address">Dirección de Residencia</label>
            <input asp-for="Address" class="user-input" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="user-field">
            <label asp-for="City">Ciudad</label>
            <input asp-for="City" class="user-input" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>

        <div class="user-field">
            <label asp-for="Country">País</label>
            <input asp-for="Country" class="user-input" />
            <span asp-validation-for="Country" class="text-danger"></span>
        </div>

        <div class="user-form-actions" style="display: flex; justify-content: space-between; ">
            <button type="submit" class="user-button">@Model.SubmitLabel</button>
            <a asp-action="Index" class="user-button user-button--ghost">Cancelar</a>
        </div>
    </form>
</section>