@model HotelCarga.Models.Customers.CustomerIndexViewModel

@{
    ViewData["Title"] = "Customers";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
}

<div class="user-shell customer-shell" data-page="customer-index">
    <section class="user-hero" data-animate>
        <div class="user-hero__content">
            <h1>Portal de administración de clientes.</h1>
            <p>
                Explore los perfiles de los clientes, revise su historial de reservas y mantenga actualizada la información de contacto para mejorar la experiencia de sus huéspedes.
            </p>
            <div class="user-hero__actions" style="display: flex; justify-content: flex-end;">
                <a asp-action="Create" class="user-button">Crear Cliente</a>
            </div>
        </div>
    </section>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="user-alert user-alert--success" data-animate>@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="user-alert user-alert--error" data-animate>@errorMessage</div>
    }

    <section class="user-surface" data-animate>
        <div class="user-surface__header">
            <div>
                <span class="user-section-tag">Búsqueda y Filtro</span>
                <h2>Buscar perfiles de clientes</h2>
            </div>
        </div>

        <form asp-action="Index" method="get" class="user-filter-grid">
            <div class="user-field">
                <label asp-for="Filters.Name">Nombre</label>
                <input asp-for="Filters.Name" class="user-input" />
            </div>
            <div class="user-field">
                <label asp-for="Filters.DocumentNumber">N° documento</label>
                <input asp-for="Filters.DocumentNumber" class="user-input" />
            </div>
            <div class="user-field">
                <label asp-for="Filters.Phone">Teléfono</label>
                <input asp-for="Filters.Phone" class="user-input" />
            </div>
            <div class="user-form-actions user-form-actions--inline">
                <button type="submit" class="user-button">Aplicar Filtros</button>
                <a asp-action="GetAll" class="user-button user-button--ghost">Limpiar</a>
            </div>
        </form>
    </section>


    <section class="user-surface" data-animate>
        <div class="user-surface__header">
            <div>
                <h2>Clientes registrados</h2>
            </div>
            <p>@Model.Customers.Count registros de clientes listos para revisión.</p>
        </div>

        @if (Model.Customers.Count == 0)
        {
            <div class="user-empty-state">
                <h3>No se encontraron clientes con este filtro.</h3>
                <p>Intente filtros más amplios o cree un nuevo perfil de cliente.</p>
            </div>
        }
        else
        {
            <div class="user-card-grid">
                @foreach (var customer in Model.Customers)
                {
                    <article class="user-card" data-animate>
                        <div class="user-card__header">
                            <div>
                                <span class="user-chip">@customer.RoleName</span>
                                <h3>@customer.FirstName @customer.LastName</h3>
                            </div>
                            <span class="user-status-pill">@customer.StatusName</span>
                        </div>
                        <dl class="user-card__meta">
                            <div>
                                <dt>Documento</dt>
                                <dd>@customer.DocumentNumber</dd>
                            </div>
                            <div>
                                <dt>Teléfono</dt>
                                <dd>@customer.Phone</dd>
                            </div>
                            <div>
                                <dt>Usuario</dt>
                                <dd>@customer.Username</dd>
                            </div>
                            <div>
                                <dt>Reservas</dt>
                                <dd>@customer.BookingsCount</dd>
                            </div>
                        </dl>
                        <div class="user-card__actions">
                            <a asp-action="GetById" asp-route-id="@customer.Id" class="user-button">Abrir</a>
                            <a asp-action="Update" asp-route-id="@customer.Id" class="user-button user-button--ghost">Actualizar</a>
                            <a asp-action="Delete" asp-route-id="@customer.Id" class="user-button user-button--ghost user-button--danger">Eliminar</a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/customer/index.js" asp-append-version="true"></script>
}