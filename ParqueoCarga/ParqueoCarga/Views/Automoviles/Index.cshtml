@model AutomovilesIndexViewModel

@{
    ViewData["Title"] = "Automóviles";
}

@section Styles {
    <link rel="stylesheet" href="~/css/automoviles.css" asp-append-version="true" />
}

<div class="automoviles-page" data-endpoint-listado="@Url.Content("~/automoviles/listado")" data-endpoint-base="@Url.Content("~/automoviles")">
    <form id="antiForgeryForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <section class="hero-shell mb-4 mb-lg-5">
        <div class="hero-backdrop"></div>
        <div class="row g-4 align-items-stretch position-relative">
            <div class="col-xl-7">
                <div class="hero-panel h-100">
                    <span class="eyebrow-pill">Operación en tiempo real</span>
                    <h1 class="hero-title">Centro de control de automóviles</h1>
                    <p class="hero-copy">
                        Gestiona ingresos vehiculares con una experiencia visual moderna, filtros inteligentes y operaciones CRUD en modal sin recargar la página.
                    </p>

                    <div class="hero-actions">
                        <button type="button" class="btn btn-hero-primary" id="openCreateModalButton">
                            Nuevo automóvil
                        </button>
                        <button type="button" class="btn btn-hero-secondary" id="refreshDataButton">
                            Actualizar tablero
                        </button>
                    </div>

                    <div class="hero-highlights">
                        <article class="highlight-chip">
                            <span class="highlight-label">UX</span>
                            <strong>Modal fluido</strong>
                        </article>
                        <article class="highlight-chip">
                            <span class="highlight-label">Filtro</span>
                            <strong>Por año y criterio</strong>
                        </article>
                        <article class="highlight-chip">
                            <span class="highlight-label">Estado</span>
                            <strong>Sin recargas</strong>
                        </article>
                    </div>
                </div>
            </div>

            <div class="col-xl-5">
                <div class="hero-metrics-card h-100">
                    <div class="metric-grid">
                        <article class="metric-card glass-card">
                            <span class="metric-label">Total visible</span>
                            <strong class="metric-value" id="totalAutomovilesValue">0</strong>
                            <small id="metricStatusText">Cargando inventario...</small>
                        </article>
                        <article class="metric-card glass-card">
                            <span class="metric-label">Fabricantes</span>
                            <strong class="metric-value" id="totalFabricantesValue">0</strong>
                            <small>Marcas distintas en la consulta</small>
                        </article>
                        <article class="metric-card glass-card">
                            <span class="metric-label">Año mínimo</span>
                            <strong class="metric-value" id="anioMinimoValue">-</strong>
                            <small>Rango inferior actual</small>
                        </article>
                        <article class="metric-card glass-card">
                            <span class="metric-label">Año máximo</span>
                            <strong class="metric-value" id="anioMaximoValue">-</strong>
                            <small>Rango superior actual</small>
                        </article>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="filters-panel glass-card mb-4">
        <div class="panel-heading-row">
            <div>
                <span class="section-kicker">Consulta dinámica</span>
                <h2 class="section-title mb-1">Filtra y ordena con precisión</h2>
                <p class="section-copy mb-0">Usa rango de años, criterio textual y orden ascendente o descendente por año.</p>
            </div>
            <div class="status-badge" id="statusBadge">
                <span class="status-dot"></span>
                <span>Sincronizado</span>
            </div>
        </div>

        <form id="filtersForm" class="row g-3 align-items-end mt-1">
            <div class="col-12 col-md-6 col-xl-2">
                <label class="form-label" for="anioInicio">Año inicial</label>
                <input class="form-control form-control-modern" id="anioInicio" name="anioInicio" type="number" min="1900" max="2100" value="@Model.Filtros.AnioInicio" placeholder="2018" />
            </div>
            <div class="col-12 col-md-6 col-xl-2">
                <label class="form-label" for="anioFin">Año final</label>
                <input class="form-control form-control-modern" id="anioFin" name="anioFin" type="number" min="1900" max="2100" value="@Model.Filtros.AnioFin" placeholder="2026" />
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <label class="form-label" for="campoBusqueda">Buscar por</label>
                <select class="form-select form-control-modern" id="campoBusqueda" name="campoBusqueda">
                    <option value="todos">Todos los campos</option>
                    <option value="fabricante">Fabricante</option>
                    <option value="color">Color</option>
                    <option value="tipo">Tipo</option>
                </select>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <label class="form-label" for="terminoBusqueda">Término</label>
                <input class="form-control form-control-modern" id="terminoBusqueda" name="terminoBusqueda" type="text" maxlength="80" placeholder="Toyota, rojo, SUV..." />
            </div>
            <div class="col-12 col-md-6 col-xl-2">
                <label class="form-label" for="orden">Orden por año</label>
                <select class="form-select form-control-modern" id="orden" name="orden">
                    <option value="desc">Descendente</option>
                    <option value="asc">Ascendente</option>
                </select>
            </div>

            <div class="col-12 d-flex flex-wrap gap-2 pt-2">
                <button type="submit" class="btn btn-filter-primary">
                    <span class="btn-label">Aplicar filtros</span>
                    <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                </button>
                <button type="button" class="btn btn-filter-secondary" id="resetFiltersButton">Limpiar</button>
            </div>
        </form>

        <div class="inline-feedback d-none mt-3" id="filtersFeedback"></div>
    </section>

    <section class="inventory-section">
        <div class="section-header-row mb-3">
            <div>
                <span class="section-kicker">Inventario visual</span>
                <h2 class="section-title mb-1">Automóviles disponibles</h2>
                <p class="section-copy mb-0">Cada tarjeta resume el vehículo y centraliza las acciones de edición y eliminación.</p>
            </div>
            <div class="legend-pill">
                <span class="legend-bar"></span>
                <span>Ordenado por año</span>
            </div>
        </div>

        <div id="cardsLoadingState" class="loading-state d-none">
            <div class="spinner-border text-warning" role="status" aria-hidden="true"></div>
            <p class="mb-0">Sincronizando datos del API...</p>
        </div>

        <div id="emptyState" class="empty-state d-none">
            <div class="empty-orb"></div>
            <h3>No hay automóviles para mostrar</h3>
            <p>Ajusta los filtros o registra un nuevo automóvil para poblar el tablero.</p>
            <button type="button" class="btn btn-hero-primary" id="emptyStateCreateButton">Crear automóvil</button>
        </div>

        <div id="automovilesGrid" class="row g-4"></div>
    </section>
</div>

<div class="modal fade" id="automovilModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-content-modern">
            <div class="modal-header border-0 pb-0">
                <div>
                    <span class="section-kicker" id="automovilModalKicker">Nuevo registro</span>
                    <h3 class="modal-title" id="automovilModalTitle">Crear automóvil</h3>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="inline-feedback d-none mb-3" id="formFeedback"></div>
                <form id="automovilForm" class="row g-3" novalidate>
                    <input type="hidden" id="automovilId" />
                    <div class="col-md-6">
                        <label class="form-label" for="fabricanteInput">Fabricante</label>
                        <input class="form-control form-control-modern" id="fabricanteInput" name="fabricante" maxlength="120" required />
                        <div class="invalid-feedback" data-valmsg-for="Fabricante"></div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="tipoInput">Tipo</label>
                        <input class="form-control form-control-modern" id="tipoInput" name="tipo" maxlength="80" required />
                        <div class="invalid-feedback" data-valmsg-for="Tipo"></div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="colorInput">Color</label>
                        <input class="form-control form-control-modern" id="colorInput" name="color" maxlength="60" required />
                        <div class="invalid-feedback" data-valmsg-for="Color"></div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="anioInput">Año</label>
                        <input class="form-control form-control-modern" id="anioInput" name="anio" type="number" min="1900" max="2100" required />
                        <div class="invalid-feedback" data-valmsg-for="Anio"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-filter-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-hero-primary" id="saveAutomovilButton">
                    <span class="btn-label" id="saveAutomovilButtonLabel">Guardar automóvil</span>
                    <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteAutomovilModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-modern danger-modal">
            <div class="modal-header border-0 pb-0">
                <div>
                    <span class="section-kicker">Confirmación</span>
                    <h3 class="modal-title">Eliminar automóvil</h3>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Esta acción eliminará el registro seleccionado del tablero.</p>
                <div class="delete-summary" id="deleteSummary"></div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-filter-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-delete-action" id="confirmDeleteButton">
                    <span class="btn-label">Eliminar ahora</span>
                    <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="appToast" class="toast toast-modern align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="appToastBody">Listo.</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/automoviles.index.js" asp-append-version="true"></script>
}
