@{
    ViewData["Title"] = "Inicio";
}

<section class="welcome-hero py-5">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-lg-7">
                <h1 class="display-5 fw-bold mb-3">Bienvenido a ParqueoCarga</h1>
                <p class="lead text-muted mb-4">
                    Proyecto base ASP.NET Core MVC para la gestion de parqueo y automoviles.
                </p>
                <a asp-controller="Automoviles" asp-action="Index" class="btn btn-primary btn-lg">
                    Ir a Automoviles
                </a>
            </div>
            <div class="col-lg-5">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h5 class="card-title mb-3">Estado inicial</h5>
                        <ul class="mb-0">
                            <li>Estructura MVC creada</li>
                            <li>Controlador base listo</li>
                            <li>Layout compartido con navbar responsive</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
