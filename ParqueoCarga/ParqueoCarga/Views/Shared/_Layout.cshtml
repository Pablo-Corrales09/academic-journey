<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ParqueoCarga</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ParqueoCarga.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    <style>
        :root {
            --pc-primary: #0f5c4d;
            --pc-secondary: #f0a202;
            --pc-bg: #f6faf8;
            --pc-text: #1f2937;
        }

        body {
            background: linear-gradient(180deg, var(--pc-bg) 0%, #edf4f1 100%);
            color: var(--pc-text);
        }

        .navbar-parqueo {
            background-color: var(--pc-primary);
        }

        .navbar-parqueo .navbar-brand,
        .navbar-parqueo .nav-link {
            color: #fff !important;
        }

        .navbar-parqueo .nav-link:hover {
            color: #ffe8b5 !important;
        }

        .btn-accent {
            background-color: var(--pc-secondary);
            border-color: var(--pc-secondary);
            color: #212529;
            font-weight: 600;
        }

        .btn-accent:hover {
            background-color: #d88f02;
            border-color: #d88f02;
            color: #212529;
        }

        main {
            min-height: calc(100vh - 140px);
        }

        footer {
            border-top: 1px solid #e5e7eb;
            background: #fff;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-parqueo shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Automoviles" asp-action="Index">ParqueoCarga</a>

                <button class="navbar-toggler bg-light border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Automoviles" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Automoviles" asp-action="Index">Automóviles</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Parqueos" asp-action="Index">Parqueos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="IngresosAutomovil" asp-action="Index">Ingresos</a>
                        </li>
                    </ul>

                    <a class="btn btn-accent" asp-area="" asp-controller="Parqueos" asp-action="Index">
                        Gestionar módulos
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main class="py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="py-3">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
            <span class="text-muted">&copy; @DateTime.Now.Year ParqueoCarga</span>
            <span class="text-muted small">ASP.NET Core MVC - .NET 10</span>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
