<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ParqueoCarga</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ParqueoCarga.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="pc-theme">
    <div class="site-background"></div>
    <header class="site-header js-sticky-header">
        <div class="shell">
            <nav class="navbar navbar-expand-lg premium-nav">
                <a class="navbar-brand brand-lockup" asp-area="" asp-controller="Automoviles" asp-action="Index">
                    <span class="brand-mark">PC</span>
                    <span class="brand-copy">
                        <strong>ParqueoCarga</strong>
                        <small>Operación premium en tiempo real</small>
                    </span>
                </a>

                <button class="navbar-toggler premium-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Abrir navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 nav-pills-premium">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Automoviles" asp-action="Index">Automóviles</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Parqueos" asp-action="Index">Parqueos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="IngresosAutomovil" asp-action="Index">Ingresos</a>
                        </li>
                    </ul>

                    <div class="nav-actions">
                        <a class="btn btn-nav-ghost" asp-area="" asp-controller="Parqueos" asp-action="Index">Explorar módulos</a>
                        <a class="btn btn-nav-primary" asp-area="" asp-controller="Automoviles" asp-action="Index">Abrir tablero</a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="site-main">
        <div class="shell shell-main">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="shell footer-shell">
            <div>
                <strong>ParqueoCarga</strong>
                <p class="mb-0">Interfaz MVC con una estética editorial, minimalista y operativa.</p>
            </div>
            <div class="footer-meta">
                <span>&copy; @DateTime.Now.Year ParqueoCarga</span>
                <span>ASP.NET Core MVC · .NET 10</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
